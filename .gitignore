.env
node_modules/
.idea/
.venv
.vscode/
__pycache__/
.codegraph/
.playwright-mcp/

# Local backup env file generated by make mode-* targets
adaptive_honeypot_system/.env.bak

# RL generated data (local only)
adaptive_honeypot_system/control_plane/rl_agent/data/*
!adaptive_honeypot_system/control_plane/rl_agent/data/.gitkeep

# Track only the current runtime RL model artifact.
adaptive_honeypot_system/control_plane/rl_agent/artifacts/*
!adaptive_honeypot_system/control_plane/rl_agent/artifacts/.gitkeep
!adaptive_honeypot_system/control_plane/rl_agent/artifacts/rl_agent_linear.json
!adaptive_honeypot_system/control_plane/rl_agent/artifacts/rl_agent_linear.metrics.json
adaptive_honeypot_system/control_plane/replay_buffer/data/*
!adaptive_honeypot_system/control_plane/replay_buffer/data/.gitkeep

# Host-mounted debug logs
adaptive_honeypot_system/logs/*
!adaptive_honeypot_system/logs/.gitkeep
!adaptive_honeypot_system/logs/README.md
!adaptive_honeypot_system/logs/real_backend/
!adaptive_honeypot_system/logs/real_backend/service_requests.jsonl
!adaptive_honeypot_system/logs/honeypots/
!adaptive_honeypot_system/logs/honeypots/*/
!adaptive_honeypot_system/logs/honeypots/*/service_requests.jsonl
!adaptive_honeypot_system/logs/llm_analyzer/
!adaptive_honeypot_system/logs/llm_analyzer/llm_fields.jsonl
!adaptive_honeypot_system/logs/metric_visualizations/
!adaptive_honeypot_system/logs/metric_visualizations/**

# Local planning/report artifacts
IMPLEMENTATION_PLAN.md
report-requirements.txt
ĐACN-TrungNhan_VanHung-LLM_HoneypotDeployment/
ĐACN_TrungNhan_VanHung_LLM_HoneypotDeployment.pdf
