BACKEND_SECRET_KEY=dev-secret-adaptive-2024
SERVICE_NAME=adaptive-honeypot-system
ENVIRONMENT=development

# Set to true to route ALL API traffic to honeypots instead of real backend
# false = normal operation (backend gets traffic)
# true = test mode (honeypots get all API traffic)
TEST_HONEYPOT=false

# Exposure mode controls what an attacker/demo user can observe.
# debug = operator/debug endpoints and detailed health metadata are visible
# attack = hide service identity, disable debug route/analyzer endpoints, hide HAProxy stats UI
EXPOSURE_MODE=debug

# Elastic Stack Credentials
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme-elasticsearch-password
ELASTICSEARCH_INDEX_PREFIX=honeypot-logs

# Kibana Configuration
KIBANA_HOST=kibana
KIBANA_PORT=5601
KIBANA_ELASTICSEARCH_PASSWORD=${ELASTICSEARCH_PASSWORD}

# Filebeat Configuration
FILEBEAT_ELASTICSEARCH_PASSWORD=${ELASTICSEARCH_PASSWORD}

# Kibana
KIBANA_URL=http://localhost:5601
KIBANA_PORT=5601

# Filebeat
FILEBEAT_HOST=filebeat
LOG_RETENTION_DAYS=30
LOG_LEVEL=INFO

# HAProxy Stats (Gateway monitoring)
HAPROXY_STATS_USER=admin
HAPROXY_STATS_PASSWORD=admin
HAPROXY_STATS_PORT=8404

# Alert thresholds
ALERT_FAILED_LOGIN_THRESHOLD=5
ALERT_SQL_INJECTION_THRESHOLD=2
ALERT_COMMAND_INJECTION_THRESHOLD=2
ALERT_SSRF_THRESHOLD=1

# LOGGING CONFIG
LOG_FORMAT_HAProxy="%ci:%cp [%tr] %ft %b/%s %TR/%Tw/%Tc/%Tr/%Ta %ST %B %CC %CS %tsc %ac/%fc/%bc/%sc/%rc %sq/%bq"
LOG_TIMEZONE=UTC
DEBUG=false

# Control plane demo policy
# heuristic = deterministic dummy RL stand-in for Web MVP
# model = load JSON LinearQAgent artifact from control_plane/rl_agent/artifacts
RL_POLICY_MODE=heuristic
HEURISTIC_ROUTE_THRESHOLD=0.45

# Dummy LLM analyzer loop
ANALYZER_ENABLED=true
ANALYZER_APPLY_ROUTE=true
ANALYZER_INTERVAL_SECONDS=2
ANALYZER_WINDOW_SECONDS=300
